+// Pool quarantine: mark [addr, addr+size) as "put back into sync.Pool".
+// Any subsequent access (same-goroutine or cross-goroutine) before a matching
+// __tsan_go_pool_unquarantine fires a use-after-pool-put report.
+//
+// Uses MemoryRangeFreed (with slot locking) so that:
+//   1. A kAccessFree trace event is recorded — RestoreStack can attribute Put.
+//   2. Shadow cells get FreedMarker — any access triggers DoReportRace.
+// The slot lock is required by MemoryRangeFreed for thread-safety.
+void __tsan_go_pool_quarantine(ThreadState *thr, uptr pc, uptr addr,
+                               uptr size) {
+  if (!size)
+    return;
+  uptr addr1 = RoundDown(addr, kShadowCell);
+  uptr size1 = RoundUp(size + addr - addr1, kShadowCell);
+  SlotLock(thr);
+  MemoryRangeFreed(thr, pc, addr1, size1);
+  SlotUnlock(thr);
+}
+
+// Pool unquarantine: reset shadow for [addr, addr+size) so the caller that
+// received the object from Pool.Get can use it without false positives.
+void __tsan_go_pool_unquarantine(ThreadState *thr, uptr pc, uptr addr,
+                                 uptr size) {
+  MemoryResetRange(thr, pc, addr, size);
+}
+
 }  // extern "C"
 }  // namespace __tsan
